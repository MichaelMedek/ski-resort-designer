{
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Skill",
      "ExitPlanMode"
    ],
    "deny": [
      "Bash(rm -*)",
      "Bash(rm --*)",
      "Bash(* && rm -*)",
      "Bash(* ; rm -*)",
      "Bash(*; rm -*)",
      "Bash(* || rm -*)"
    ],
    "additionalDirectories": [
      "/"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/deny-git-mutations.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
